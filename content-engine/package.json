{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "description": "内容引擎桌面端 MVP",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "bailian-cli": "1.10.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.zhineng.contentengine",
    "productName": "内容引擎",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}

{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "description": "内容引擎 Web 应用",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "node --watch server/index.cjs",
    "dev:worker": "node --watch server/worker.cjs",
    "start": "node server/index.cjs",
    "db:migrate": "node server/migrate.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@vitejs/plugin-react": "latest",
    "animejs": "^4.5.0",
    "bailian-cli": "1.10.1",
    "bullmq": "^5.81.1",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "lucide-react": "latest",
    "pg": "^8.22.0",
    "playwright-core": "^1.62.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "typescript": "latest"
  }
}
